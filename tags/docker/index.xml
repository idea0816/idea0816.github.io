    <item>
      <title>Setup n8n Server on Synology&#39;s Container Manager</title>
      <link>https://idea0816.github.io/2026/04/06/setup-n8n-on-docker/</link>
      <pubDate>Mon, 06 Apr 2026 09:20:00 +0800</pubDate>
